# ---------------------------------------------------------------- core
NODE_ENV=development
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- backend API
# Absolute base URL of the KMCP API, INCLUDING the /api/v1 suffix.
# Leave unset to run the portal on its bundled mock dataset.
# Local:      http://localhost:4000/api/v1
# Production: https://<your-backend>.vercel.app/api/v1
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------- database (Neon)
DATABASE_URL="postgresql://user:password@host/kmcp?sslmode=require"
DIRECT_URL="postgresql://user:password@host/kmcp?sslmode=require"

# ---------------------------------------------------------------- auth
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------- cache
REDIS_URL=
REDIS_TOKEN=

# ---------------------------------------------------------------- object storage
S3_ENDPOINT=
S3_BUCKET=kmcp-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_SIGNED_URL_TTL=900

# ---------------------------------------------------------------- payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# ---------------------------------------------------------------- messaging
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
RESEND_API_KEY=

# ---------------------------------------------------------------- maps
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ---------------------------------------------------------------- ops
SENTRY_DSN=
LOG_LEVEL=info
CRON_SECRET=
